# Runtime state and generated config, which no-littering keeps in these two dirs. See init.el.
/var
/etc
# Byte-compiled elisp, from `make compile`
*.elc
# Native-compiled elisp from `emacs -Q` runs, which don't redirect it to var/
/eln-cache
# Claude Code working plans for past changes
/.claude/plans/
# Claude Code per-user settings
/.claude/settings.local.json
